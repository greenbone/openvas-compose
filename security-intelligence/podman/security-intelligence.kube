# Quadlet unit: deploy the whole stack as one systemd service.
#
# Install (root):
#   install -d /etc/containers/security-intelligence
#   cp rendered/security-intelligence.yaml /etc/containers/security-intelligence/
#   cp security-intelligence.kube /etc/containers/systemd/
#   systemctl daemon-reload
#   systemctl start security-intelligence.service
#
# The YAML path must be absolute and readable by podman. Secrets are inside the
# YAML (generated by deploy.sh) - keep that file 0600 if the host is shared.
[Unit]
Description=Greenbone openSight security-intelligence
Wants=network-online.target
After=network-online.target

[Kube]
Yaml=/etc/containers/security-intelligence/security-intelligence.yaml
# NodePort-equivalent host publishing: quadlet renders these into
# `podman kube play --publish <host>:<container>`
PublishPort=30443:8443
PublishPort=30080:8080

[Install]
WantedBy=multi-user.target
